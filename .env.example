# Copy to .env.local (and add the same values in your host's env settings).
# Everything here is optional — the site works without any of it.

# ── Contact form → Telegram (free, instant on your phone) ──
# 1. Telegram → @BotFather → /newbot → copy the token below.
# 2. Send your bot any message, open https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy "chat":{"id": ...} below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Chat assistant → Claude AI (paid, optional) ──
# Without a key the assistant uses the free built-in engine (lib/chat/localReply.ts).
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-opus-5-5
